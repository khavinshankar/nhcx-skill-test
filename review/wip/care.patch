@@ -22,6 +22,37 @@ def bundle(name: str) -> dict:
     return json.loads((BUNDLES / name).read_text())
 
 
+FAMILY = (("PMJAY0000Y", "RAVI", "91-0000-0000-0001", "1980-05-05", "male"),)
+
+
+def family_bundle(name="eligibility-auth-response-pmjay.json", members=FAMILY):
+    """A PMJAY reply that also lists other family members, the checked one first."""
+    out = bundle(name)
+    base = "https://payer.nha.gov.in/coverageeligibility/v1/coverageeligibility/on_check/coverageeligibilityresponse"
+    patient = next(
+        e for e in out["entry"] if e["fullUrl"] == f"{base}/patient/PMJAY0000X"
+    )
+    coverage = next(
+        e
+        for e in out["entry"]
+        if e["resource"]["resourceType"] == "Coverage"
+        and e["fullUrl"].startswith(f"{base}/coverage/")
+    )
+    for member_id, name_, abha, dob, gender in members:
+        p = json.loads(json.dumps(patient).replace("PMJAY0000X", member_id))
+        p["resource"]["name"] = [{"text": name_}]
+        p["resource"]["birthDate"] = dob
+        p["resource"]["gender"] = gender
+        for identifier in p["resource"]["identifier"]:
+            if identifier["type"]["coding"][0]["code"] == "ABHA":
+                identifier["value"] = abha
+        c = json.loads(json.dumps(coverage).replace("PMJAY0000X", member_id))
+        c["fullUrl"] = f"{base}/coverage/{member_id}"
+        c["resource"]["beneficiary"] = {"reference": f"{base}/patient/{member_id}"}
+        out["entry"] += [p, c]
+    return out
+
+
