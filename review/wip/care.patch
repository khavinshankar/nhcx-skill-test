+"""The beneficiary of a case when the eligibility reply lists a whole family.
+
+A family policy (PMJAY) answers an eligibility check with every member on
+the card. The case is prefilled with the member that matches the HMIS
+patient it was opened for; otherwise the desk chooses one.
+
+Public:
+- ``options(claim) -> [dict]``: the members the last reply listed.
+- ``pending(claim) -> bool``: more than one member and none chosen yet.
+- ``require_chosen(claim)``: refuses while ``pending``.
+- ``resolve(claim, people) -> dict | None``: the member to apply after a reply.
+- ``apply(claim, person)``: copy a member onto the case (no save).
+- ``select(claim, member_id) -> str``: the desk's choice.
+"""
+
+import re
+
+from django.db import transaction
+
+from care.nhcx.fhir.read import eligibility as read_elig
+from care.nhcx.services import stage
+from care.nhcx.services.common import ServiceRefusal, get_claim
+
+PERSON_COLUMNS = (
+    "beneficiary_name",
+    "patient_gender",
+    "patient_dob",
+    "patient_address",
+    "abha_number",
+    "patient_photo",
+    "plan_name",
+    "plan_period_start",
+    "plan_period_end",
+    "relationship",
+)
+CHOOSE_FIRST = (
+    "The payer lists more than one beneficiary on this policy. Choose the "
+    "patient on the Eligibility tab first."
+)
+NOT_LISTED = "That member is not on the payer's last eligibility reply."
+TOO_LATE = "The beneficiary cannot be changed once a pre-authorisation has been sent."
+
+
+def options(claim) -> list:
+    if not isinstance(claim.response_json, dict):
+        return []
+    return read_elig.read_beneficiaries(claim.response_json)
+
+
+def _chosen(claim, people):
+    wanted = (claim.beneficiary_member_id or "").strip()
+    return next((p for p in people if wanted and p["member_id"] == wanted), None)
+
+
+def pending(claim, people=None) -> bool:
+    people = options(claim) if people is None else people
+    return len(people) > 1 and _chosen(claim, people) is None
+
+
+def require_chosen(claim):
+    if pending(claim):
+        raise ServiceRefusal(CHOOSE_FIRST)
+
+
+def _digits(value) -> str:
+    return re.sub(r"\D", "", value or "")
+
+
+def _name(value) -> str:
+    return " ".join((value or "").lower().split())
+
+
+def _match(patient, people):
+    """The one member that is this HMIS patient, by ABHA number, then by name."""
+    if patient is None:
+        return None
+    from care.nhcx.models.abha import get_abha_number
+
+    abha = _digits(get_abha_number(patient))
+    if abha:
+        found = [p for p in people if _digits(p.get("abha_number")) == abha]
+        if len(found) == 1:
+            return found[0]
+    name = _name(patient.name)
+    dob = patient.date_of_birth.isoformat() if patient.date_of_birth else ""
+    found = [
+        p
+        for p in people
+        if name
+        and _name(p.get("beneficiary_name")) == name
+        and (not dob or not p.get("patient_dob") or p["patient_dob"][:10] == dob)
+    ]
+    return found[0] if len(found) == 1 else None
+
+
+def resolve(claim, people):
+    """The member to apply after a reply: the one already chosen, else the HMIS patient."""
+    return _chosen(claim, people) or _match(claim.patient, people)
+
+
+def apply(claim, person):
+    for column in PERSON_COLUMNS:
+        setattr(claim, column, person.get(column) or None)
+    claim.member_id = person["member_id"]
+    claim.beneficiary_member_id = person["member_id"]
+
+
+def select(claim, member_id) -> str:
+    claim = get_claim(claim)
+    member_id = (member_id or "").strip()
+    person = next((p for p in options(claim) if p["member_id"] == member_id), None)
+    if person is None:
+        raise ServiceRefusal(NOT_LISTED)
+    if getattr(claim, "preauth", None) is not None:
+        raise ServiceRefusal(TOO_LATE)
+    with transaction.atomic():
+        apply(claim, person)
+        claim.save()
+        stage.recompute(claim)
+    return f"{person.get('beneficiary_name') or member_id} is the beneficiary."
