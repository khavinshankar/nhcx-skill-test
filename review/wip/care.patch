+
+
+def _resolve(bundle, reference, resource_type):
+    found = fb.resolve_reference(bundle, reference)
+    if isinstance(found, dict) and found.get("resourceType") == resource_type:
+        return found
+    return None
+
+
+def read_beneficiaries(bundle):
+    """Every beneficiary the reply lists, each with its own Coverage.
+
+    A family policy (PMJAY) answers with one Patient and Coverage per family
+    member; the request's own Patient and Coverage are left out. ``checked``
+    marks the member the CoverageEligibilityResponse is about.
+    """
+    bundle = fb.unwrap(bundle)
+    response = fb.find_resource(bundle, "CoverageEligibilityResponse")
+    if response is None:
+        return []
+    request = fb.find_resource(bundle, "CoverageEligibilityRequest") or {}
+    asked = {
+        id(r)
+        for r in (
+            _resolve(bundle, request.get("patient"), "Patient"),
+            *(
+                _resolve(bundle, i.get("coverage"), "Coverage")
+                for i in request.get("insurance") or []
+            ),
+        )
+        if r is not None
+    }
+    checked = _resolve(bundle, response.get("patient"), "Patient")
+    coverages = {}
+    for coverage in fb.find_resources(bundle, "Coverage"):
+        if id(coverage) in asked:
+            continue
+        patient = _resolve(bundle, coverage.get("beneficiary"), "Patient")
+        if patient is not None:
+            coverages.setdefault(id(patient), coverage)
+    out, seen = [], set()
+    for patient in fb.find_resources(bundle, "Patient"):
+        if id(patient) in asked:
+            continue
+        member_id = _member_id(patient)
+        if not member_id or member_id in seen:
+            continue
+        seen.add(member_id)
+        person = {"member_id": member_id, "checked": patient is checked}
+        person.update(_patient_fields(patient))
+        person.update(_coverage_fields(coverages.get(id(patient))))
+        out.append(person)
+    return out
+
