# NHCX end-to-end tests (L8, T1). Copy to .env beside this file (git-ignored)
# and fill in what is blank. The environment wins over the file; a default
# applies only when the variable is unset. No secret belongs in this file.

# Which runner `nhcx_e2e run` starts: gui, cli or both.
NHCX_TEST_MODE=both
# Comma-separated test ids (T5,T6) or a payer (irdai, pmjay); empty = every test.
NHCX_TEST_ONLY=

# GUI runner: where the HMIS is served and who signs in (a user holding a role
# at the test facility; `nhcx_e2e setup` creates one and prints what to set).
NHCX_TEST_APP_URL=http://localhost:4000
NHCX_TEST_USER=
NHCX_TEST_PASSWORD=
# The test facility (external id); `nhcx_e2e setup` creates it.
NHCX_TEST_FACILITY=
# A practitioner (username or external id) with an HPR id; default: the first one.
NHCX_TEST_DOCTOR=
# The ICD-10 code the pre-authorisation quotes.
NHCX_TEST_DIAGNOSIS=
# A seeded PMJAY package the sandbox does not decide by itself (T15, T16).
NHCX_TEST_PMJAY_MANUAL_PACKAGE=
NHCX_TEST_SLOWMO_MS=0
NHCX_TEST_BROWSER_CHANNEL=chromium

# Test payers (defaults from references/PAYERS.md when unset).
NHCX_TEST_IRDAI_PAYER=
NHCX_TEST_IRDAI_MEMBER_ID=
# Optional: which of the member's policies to claim on (a policy code, e.g. when
# repeated runs have used up the cover of the first one). Default: the first found.
NHCX_TEST_IRDAI_POLICY=
NHCX_TEST_PMJAY_PAYER=
# Asked from the integrator; never guessed.
NHCX_TEST_PMJAY_MEMBER_ID=
NHCX_TEST_PMJAY_PLAN_SEED=
NHCX_TEST_PLAN_WAIT_SECONDS=120
# Secret: the NHCX Payer Service token; default is the facility's own session token.
NHCX_TEST_PMJAY_SERVICE_TOKEN=
NHCX_TEST_WAIT_SECONDS=120
# PMJAY's sandbox pays about 8 minutes after the claim is approved.
NHCX_TEST_PMJAY_PAYMENT_WAIT_SECONDS=600
NHCX_TEST_POLL_AFTER_SECONDS=30
# Relative paths are taken from the care repository root.
NHCX_TEST_REPORT=nhcx-plan/e2e.json

# Test data that `nhcx_e2e setup` writes on the facility and doctor records.
# Defaults to the registry_id the registry holds for the facility participant
# (PMJAY refuses any other HFR id with PAYR-1008).
# NHCX_TEST_HFR_ID=
NHCX_TEST_HPR_ID=71-1234-5678-9012
# 1 = biometric and ABHA stand-ins for T19 (not provided by this harness yet).
NHCX_TEST_ABDM_FAKE=1
