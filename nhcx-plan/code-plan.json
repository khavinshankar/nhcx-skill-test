{
 "grouping": "by layer",
 "conventions": [
  {
   "topic": "models",
   "rule": "subclass care.emr.models.base.EMRBaseModel (external_id UUID, created/modified dates, soft delete)",
   "example": {
    "file": "care/emr/models/account.py",
    "lines": "7-32"
   }
  },
  {
   "topic": "API",
   "rule": "DRF views; pydantic specs for request validation like care/emr/resources; facility-scoped URL /api/v1/facility/<facility_external_id>/nhcx/...",
   "example": {
    "file": "care/emr/api/viewsets/account.py",
    "lines": "1-80"
   }
  },
  {
   "topic": "errors",
   "rule": "raise rest_framework ValidationError with verbatim spec messages; services return dicts",
   "example": {
    "file": "care/emr/api/viewsets/account.py",
    "lines": "1-80"
   }
  },
  {
   "topic": "tests",
   "rule": "Django TestCase / care.utils.tests.base CareAPITestBase; files test_*.py under app tests/",
   "example": {
    "file": "care/emr/tests/test_account_api.py",
    "lines": "1-60"
   }
  },
  {
   "topic": "background",
   "rule": "Celery shared_task, beat schedule in config/settings",
   "example": {
    "file": "config/celery_app.py",
    "lines": "1-30"
   }
  },
  {
   "topic": "money",
   "rule": "DecimalField(max_digits=20, decimal_places=2)",
   "example": {
    "file": "care/emr/models/charge_item.py",
    "lines": "7-56"
   }
  },
  {
   "topic": "FE",
   "rule": "TanStack Query with query()/mutate() helpers; routes object in Routers/routes; shadcn ui; i18n t() keys in public/locale/en.json",
   "example": {
    "file": "care_fe/src/pages/Facility/billing/",
    "lines": ""
   }
  }
 ],
