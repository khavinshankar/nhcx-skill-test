 "corrections": [
  {
   "spec": "API auth",
   "what": "Anonymous requests get 403 (not_authenticated), not 401: CARE's authenticators return an empty WWW-Authenticate header, so DRF downgrades the status platform-wide.",
   "source": "config/authentication.py authenticate_header"
  }
 ],
 "notes": [
  "payers.py (adapter_for/workflow_id) is owned by services-legs; common.adapter() delegates to it.",
  "Added an extra_headers hook; reads getattr settings NHCX_CLAIM_PREFIX and NHCX_DEFAULT_PAYER_CODE.",
  "Task callbacks route to callbacks.enquiry with route C7/C8.",
  "state.claim_state adds a required_forms alias.",
  "C3 checks for a response before revive; ensure_auth_requirements returns False on failure; registry errors -> 400; tier_offers passed empty.",
  "Extra core-owned module services/lines.py plus endpoints PUT claims/<id>/lines/ (bulk update), DELETE claims/<id>/lines/<line>/, POST/DELETE claims/<id>/admission/.",
  "Ledger API is superuser-only; POST claims/ also supports discovery (payer_code/id_type).",
  "Admissions treat 'discharged' as finished.",
  "No model changes / migrations."
 ]
}